# Copy this file to ".env" in this same folder and fill in the value
# below. This is the SAME value already set in Vercel for the web
# dashboard — you're not generating a new key, just copying the one you
# already have.

ANTHROPIC_API_KEY=

# Required now that the dashboard API requires authentication. This is its
# OWN independent secret — do not reuse ANTHROPIC_API_KEY, the dashboard
# login password, or any MCP key here. Generate a random value yourself
# and set the exact same value in Vercel's COMMAND_CENTER_API_KEY
# environment variable.
COMMAND_CENTER_API_KEY=

# Optional — only needed if the web dashboard's URL ever changes. Leave
# this blank/commented out to use the default already baked into the
# script.
# DASHBOARD_BASE_URL=https://your-dashboard-url.vercel.app

# Optional — change the activation hotkey if ctrl+alt+m conflicts with
# something else.
# MYA_HOTKEY=ctrl+alt+j

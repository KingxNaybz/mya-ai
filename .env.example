# Server-side environment variables for the Command Center auth/security
# remediation (claude/security-remediation). These are set directly in
# Vercel's project settings, not read from a file at runtime — this file
# documents what to set there. Every value below is a PLACEHOLDER; do not
# commit or share real values.

# The single-owner dashboard login password. Used ONLY to verify the
# password submitted at login — it is never used to sign or verify session
# cookies (see SESSION_SIGNING_SECRET below; the two are deliberately
# independent secrets with no derivation between them).
DASHBOARD_PASSWORD=replace-with-a-strong-passphrase

# The key that signs and verifies the mya_session cookie. Must be a long,
# randomly generated value (e.g. `openssl rand -hex 32`) — never a
# human-typed password, and never the same value as DASHBOARD_PASSWORD.
# Required: if unset, session issuance and validation both fail closed
# (no dashboard session can be created or accepted).
SESSION_SIGNING_SECRET=replace-with-a-long-random-hex-string

# The desktop app's own credential, sent as the x-command-center-key
# header. Independent from DASHBOARD_PASSWORD, SESSION_SIGNING_SECRET, and
# MCP_BRIDGE_KEY. The exact same value also goes in desktop-app/.env as
# COMMAND_CENTER_API_KEY.
COMMAND_CENTER_API_KEY=replace-with-a-long-random-string

# Optional — login throttling thresholds for a single-owner administrative
# dashboard. Sensible defaults are baked in (5 / 15 / 15) if any of these
# are left unset; only set them to override.
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_WINDOW_MINUTES=15
# LOGIN_LOCKOUT_MINUTES=15

# ---- Reception Mya call-start webhook authentication ----
# Verifies POST /api/mya-call-start requests genuinely came from our
# ElevenLabs "Conversation Initiation Client Data" webhook, via a static
# secret header ElevenLabs is configured (in that agent's own Security tab,
# under "Request headers") to send with every call. This is ElevenLabs'
# own supported mechanism for THIS webhook type specifically — it does not
# offer an HMAC/signing-secret option here (the post-call webhook is
# different and uses HMAC; see mya-call-ended.ts, not yet implemented).
#
# Its own dedicated credential — independent from DASHBOARD_PASSWORD,
# SESSION_SIGNING_SECRET, COMMAND_CENTER_API_KEY, and MCP_BRIDGE_KEY. Never
# reuse any of those here or vice versa.
#
# Leave both unset (their state until you complete setup below) and this
# file behaves exactly as it always has — no check runs at all.
#
# 1. Generate a value (e.g. `openssl rand -hex 32`) and set it here AND as
#    the header value in ElevenLabs' agent Security tab, under the header
#    name x-mya-call-start-key.
# MYA_CALL_START_WEBHOOK_KEY=replace-with-a-long-random-hex-string
#
# 2. Leave MYA_CALL_START_AUTH_MODE unset (or "log-only") at first — a
#    missing/wrong header is only logged (as true/false, never the actual
#    values), never rejected. Watch Vercel's Runtime Logs for a real
#    ElevenLabs call and confirm it shows headerPresent:true,matched:true.
#    Only once that's confirmed, set this to "enforce" so a missing/wrong
#    header gets a 401 instead. This second step is a config-only change —
#    no code change or redeploy needed.
# MYA_CALL_START_AUTH_MODE=log-only
